# ===== Backend (server/index.js) =====
# Port. Render always overrides this with its own PORT value.
PORT=4000
# Bind address. 0.0.0.0 keeps the API reachable from the ESP32 on your LAN.
HOST=0.0.0.0
# Comma-separated browser origins allowed by CORS. Empty = allow any origin.
# Render: CORS_ORIGIN=https://your-frontend.onrender.com
CORS_ORIGIN=

# ===== Frontend (Vite) — build-time, must start with VITE_ =====
# Empty = local dev: the Vite dev server proxies /api to http://localhost:4000.
# Render: VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
